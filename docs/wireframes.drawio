        </mxCell>
        <mxCell id="8" value="→ Canceled" style="edgeStyle=orthogonalEdgeStyle;html=1;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" source="3" target="6" parent="1">
