        </mxCell>
        <!-- Arrows -->
        <mxCell id="7" value="→ Started" style="edgeStyle=orthogonalEdgeStyle;html=1;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" source="3" target="4" parent="1">
