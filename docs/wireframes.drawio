          <mxGeometry x="80" y="500" width="400" height="24" as="geometry"/>
        </mxCell>
        <mxCell id="15" value="○ Completed — Fullfør. Ratings fryses. Irreversibelt." style="text;html=1;align=left;verticalAlign=middle;fontSize=12;" vertex="1" parent="1">
