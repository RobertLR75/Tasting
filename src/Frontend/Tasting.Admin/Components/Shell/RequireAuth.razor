@using Microsoft.AspNetCore.Components.Authorization
@using Tasting.Admin.Features.Auth.Services
@inject TastingAuthStateProvider AuthStateProvider
@inject NavigationManager Navigation
@implements IDisposable

@ChildContent

@code {
    [Parameter] public RenderFragment? ChildContent { get; set; }

    protected override async Task OnInitializedAsync()
    {
        AuthStateProvider.AuthenticationStateChanged += OnAuthStateChanged;
        await RedirectIfNotAuthenticatedAsync();
    }

    private void OnAuthStateChanged(Task<AuthenticationState> task)
    {
        _ = InvokeAsync(async () => await RedirectIfNotAuthenticatedAsync(task));
    }

    private async Task RedirectIfNotAuthenticatedAsync(Task<AuthenticationState>? stateTask = null)
    {
        var state = stateTask is null
            ? await AuthStateProvider.GetAuthenticationStateAsync()
            : await stateTask;

        if (!(state.User.Identity?.IsAuthenticated ?? false))
        {
            Navigation.NavigateTo("/login", forceLoad: false, replace: true);
        }
    }

    public void Dispose()
    {
        AuthStateProvider.AuthenticationStateChanged -= OnAuthStateChanged;
    }
}
