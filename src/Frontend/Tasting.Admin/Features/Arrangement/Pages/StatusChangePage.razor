@page "/arrangements/{ArrangementId:guid}/status"
@using MudBlazor
@using Tasting.Admin.Features.Arrangement.Models
@using Tasting.Admin.Features.Arrangement.Services
@using Tasting.Admin.Shared.Components
@implements IDisposable
@inject IArrangementsApiClient ArrangementsApiClient
@inject NavigationManager Navigation

<PageTitle>Change Arrangement Status</PageTitle>

<FormLayout Title="Change Arrangement Status" ErrorMessage="@errorMessage">
    @if (currentArrangement != null)
    {
        <MudText Typo="Typo.body1" Class="mb-3">Name: @currentArrangement.Name</MudText>
        <MudText Typo="Typo.body1" Class="mb-3">Current Status: <StatusBadge Status="@currentArrangement.Status.ToString()" /></MudText>
    }

    @if (currentArrangement != null && validTransitions.Count == 0)
    {
        <MudAlert Severity="Severity.Info">
            No further status transitions are available. There are no further transitions possible for this arrangement.
        </MudAlert>
    }
    else if (currentArrangement != null)
    {
        <MudSelect T="ArrangementStatus"
                   Label="New Status"
                   @bind-Value="@selectedNewStatus"
                   Required="true"
                   Variant="Variant.Outlined"
                   Class="mb-3">
            @foreach (var status in validTransitions)
            {
                <MudSelectItem T="ArrangementStatus" Value="@status">@status</MudSelectItem>
            }
        </MudSelect>
    }

    <MudStack Row="true" Spacing="2">
        @if (currentArrangement == null || validTransitions.Count > 0)
        {
            <ActionButton
                Text="Change Status"
                Color="Color.Success"
                OnClick="@HandleChangeStatusAsync"
                Disabled="@isLoading" />
        }
        <ActionButton 
            Text="Cancel" 
            Color="Color.Default"
            OnClick="@HandleCancel" />
    </MudStack>
</FormLayout>

@code {
    [Parameter]
    public Guid ArrangementId { get; set; }

    private ArrangementDto? currentArrangement;
    private ArrangementStatus selectedNewStatus;
    private IReadOnlyList<ArrangementStatus> validTransitions = [];
    private string? errorMessage;
    private bool isLoading = false;
    private readonly CancellationTokenSource _cts = new();

    protected override async Task OnInitializedAsync()
    {
        isLoading = true;
        try
        {
            currentArrangement = await ArrangementsApiClient.GetAsync(ArrangementId);
            if (_cts.IsCancellationRequested) return;
            if (currentArrangement != null)
            {
                validTransitions = GetValidTransitions(currentArrangement.Status);
                selectedNewStatus = validTransitions.FirstOrDefault();
            }
        }
        catch (OperationCanceledException)
        {
        }
        catch (Exception ex)
        {
            if (_cts.IsCancellationRequested) return;
            errorMessage = $"Failed to load arrangement: {ex.Message}";
        }
        finally
        {
            if (!_cts.IsCancellationRequested)
                isLoading = false;
        }
    }

    private async Task HandleChangeStatusAsync()
    {
        if (currentArrangement == null)
        {
            errorMessage = "Arrangement must be loaded before changing status";
            return;
        }

        if (validTransitions.Count == 0)
        {
            errorMessage = "No further status transitions are available.";
            return;
        }

        isLoading = true;
        errorMessage = null;

        try
        {
            var result = await ChangeStatusAsync(selectedNewStatus);
            if (_cts.IsCancellationRequested) return;
            if (result != null)
            {
                Navigation.NavigateTo("/arrangements");
            }
        }
        catch (OperationCanceledException)
        {
        }
        catch (Exception ex)
        {
            if (_cts.IsCancellationRequested) return;
            errorMessage = $"Failed to change status: {ex.Message}";
        }
        finally
        {
            if (!_cts.IsCancellationRequested)
                isLoading = false;
        }
    }

    private Task<ArrangementDto?> ChangeStatusAsync(ArrangementStatus newStatus)
        => newStatus switch
        {
            ArrangementStatus.Active => ArrangementsApiClient.ActivateAsync(ArrangementId, currentArrangement!.RowVersion),
            ArrangementStatus.Started => ArrangementsApiClient.StartAsync(ArrangementId, currentArrangement!.RowVersion),
            ArrangementStatus.Canceled => ArrangementsApiClient.CancelAsync(ArrangementId, currentArrangement!.RowVersion),
            ArrangementStatus.Completed => ArrangementsApiClient.CompleteAsync(ArrangementId, currentArrangement!.RowVersion),
            _ => throw new InvalidOperationException($"Arrangement cannot be changed to status '{newStatus}' from this page.")
        };

    private static IReadOnlyList<ArrangementStatus> GetValidTransitions(ArrangementStatus current)
        => current switch
        {
            ArrangementStatus.Created => [ArrangementStatus.Active, ArrangementStatus.Canceled],
            ArrangementStatus.Active => [ArrangementStatus.Started],
            ArrangementStatus.Started => [ArrangementStatus.Completed],
            ArrangementStatus.Canceled => [],
            ArrangementStatus.Completed => [],
            _ => []
        };

    private void HandleCancel()
    {
        Navigation.NavigateTo("/arrangements");
    }

    public void Dispose()
    {
        _cts.Cancel();
        _cts.Dispose();
    }
}
