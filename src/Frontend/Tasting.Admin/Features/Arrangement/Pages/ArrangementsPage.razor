@page "/"
@page "/arrangements"
@using MudBlazor
@using Tasting.Admin.Features.Arrangement.Models
@using Tasting.Admin.Features.Arrangement.Services
@using Tasting.Admin.Shared.Components
@implements IDisposable
@inject IArrangementsApiClient ArrangementsApiClient
@inject NavigationManager Navigation

<PageTitle>Arrangements</PageTitle>

<PageHeader Title="Arrangements" />

<MudStack Row="true" Spacing="2" AlignItems="AlignItems.Center" Class="mb-4">
    <MudTextField @bind-Value="SearchTerm"
                  Label="Search arrangements"
                  Placeholder="Search by name"
                  Variant="Variant.Outlined"
                  Immediate="true" />
    <ActionButton Text="Search" Color="Color.Primary" OnClick="@SearchAsync" />
    <ActionButton Text="Add Arrangement" Color="Color.Success" OnClick="@(() => Navigation.NavigateTo("/arrangements/add"))" />
</MudStack>

@if (ErrorMessage is not null)
{
    <ErrorAlert Message="@ErrorMessage" />
}
else if (IsLoading)
{
    <LoadingIndicator />
}
else if (Arrangements.Count == 0)
{
    <MudAlert Severity="Severity.Info" Dense="true">No arrangements found.</MudAlert>
}
else
{
    <MudTable Items="Arrangements" Hover="true" Dense="true">
        <HeaderContent>
            <MudTh>Name</MudTh>
            <MudTh>Status</MudTh>
            <MudTh>Created</MudTh>
            <MudTh>Actions</MudTh>
        </HeaderContent>
        <RowTemplate>
            <MudTd DataLabel="Name">@context.Name</MudTd>
            <MudTd DataLabel="Status">
                <StatusBadge Status="@context.Status.ToString()" />
            </MudTd>
            <MudTd DataLabel="Created">@context.CreatedAt.ToString("yyyy-MM-dd")</MudTd>
            <MudTd DataLabel="Actions">
                <MudStack Row="true" Spacing="1">
                    <MudTooltip Text="@(IsAddContentDisabled(context.Status) ? $"Not available for {context.Status} arrangements" : "Edit arrangement")">
                        <MudIconButton Icon="@Icons.Material.Filled.Edit" Size="Size.Small" aria-label="Edit arrangement" Disabled="@IsAddContentDisabled(context.Status)" OnClick="@(() => Navigation.NavigateTo($"/arrangements/{context.Id}/edit"))" />
                    </MudTooltip>
                    <MudTooltip Text="@(IsAddContentDisabled(context.Status) ? $"Not available for {context.Status} arrangements" : "Manage beers")">
                        <MudIconButton Icon="@Icons.Material.Filled.LocalDrink" Size="Size.Small" aria-label="Manage beers" Disabled="@IsAddContentDisabled(context.Status)" OnClick="@(() => Navigation.NavigateTo($"/arrangements/{context.Id}/beers"))" />
                    </MudTooltip>
                    <MudTooltip Text="@(IsAddContentDisabled(context.Status) ? $"Not available for {context.Status} arrangements" : "Manage participants")">
                        <MudIconButton Icon="@Icons.Material.Filled.People" Size="Size.Small" aria-label="Manage participants" Disabled="@IsAddContentDisabled(context.Status)" OnClick="@(() => Navigation.NavigateTo($"/arrangements/{context.Id}/participants"))" />
                    </MudTooltip>
                    <MudTooltip Text="@(IsStatusDisabled(context.Status) ? "No further status transitions available" : "Change status")">
                        <MudIconButton Icon="@Icons.Material.Filled.PlayArrow" Size="Size.Small" aria-label="Change status" Disabled="@IsStatusDisabled(context.Status)" OnClick="@(() => Navigation.NavigateTo($"/arrangements/{context.Id}/status"))" />
                    </MudTooltip>
                </MudStack>
            </MudTd>
        </RowTemplate>
    </MudTable>
}

@code {
    private List<ArrangementDto> Arrangements { get; set; } = new();
    private string SearchTerm { get; set; } = "";
    private string? ErrorMessage { get; set; }
    private bool IsLoading { get; set; } = true;
    private readonly CancellationTokenSource _cts = new();

    protected override async Task OnInitializedAsync()
    {
        await SearchAsync();
    }

    private static bool IsAddContentDisabled(ArrangementStatus status) =>
        status is ArrangementStatus.Started or ArrangementStatus.Canceled or ArrangementStatus.Completed;

    private static bool IsStatusDisabled(ArrangementStatus status) =>
        status is ArrangementStatus.Completed;

    private async Task SearchAsync()
    {
        IsLoading = true;
        ErrorMessage = null;
        try
        {
            var response = await ArrangementsApiClient.ListAsync(SearchTerm);
            if (_cts.IsCancellationRequested) return;
            Arrangements = response?.Items.ToList() ?? new();
        }
        catch (OperationCanceledException)
        {
        }
        catch (Exception ex)
        {
            if (_cts.IsCancellationRequested) return;
            ErrorMessage = $"Failed to load arrangements: {ex.Message}";
        }
        finally
        {
            if (!_cts.IsCancellationRequested)
                IsLoading = false;
        }
    }

    public void Dispose()
    {
        _cts.Cancel();
        _cts.Dispose();
    }
}
