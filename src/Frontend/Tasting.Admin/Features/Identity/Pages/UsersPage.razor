@page "/users"
@attribute [Microsoft.AspNetCore.Components.RouteAttribute("/users")]

<PageTitle>Users</PageTitle>

<MudText Typo="Typo.h3" GutterBottom="true">Users</MudText>

<MudStack Row="true" Spacing="2" AlignItems="AlignItems.Center" Class="mb-4">
    <MudTextField Value="SearchTerm"
                  ValueChanged="@(value => SearchTerm = value ?? string.Empty)"
                  Label="Search users"
                  Placeholder="Search by name or email"
                  Variant="Variant.Outlined"
                  Immediate="true" />
    <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="SearchAsync">
        Search
    </MudButton>
</MudStack>

@if (ErrorMessage is not null)
{
    <MudAlert Severity="Severity.Error" Dense="true" Class="mb-4">@ErrorMessage</MudAlert>
}
else if (IsLoading)
{
    <MudProgressCircular Indeterminate="true" Color="Color.Primary" />
}
else if (Users.Count == 0)
{
    <MudAlert Severity="Severity.Info" Dense="true">No users found.</MudAlert>
}
else
{
    <MudTable Items="Users" Hover="true" Dense="true">
        <HeaderContent>
            <MudTh>Name</MudTh>
            <MudTh>Email</MudTh>
            <MudTh>Role</MudTh>
            <MudTh>Status</MudTh>
        </HeaderContent>
        <RowTemplate>
            <MudTd DataLabel="Name">@($"{context.FirstName} {context.LastName}")</MudTd>
            <MudTd DataLabel="Email">@context.Email</MudTd>
            <MudTd DataLabel="Role">@context.Role</MudTd>
            <MudTd DataLabel="Status">@(context.IsActive ? "Active" : "Inactive")</MudTd>
        </RowTemplate>
    </MudTable>
}
