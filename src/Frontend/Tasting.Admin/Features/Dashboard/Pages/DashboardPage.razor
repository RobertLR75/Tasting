@page "/dashboard"
@page "/"
@using MudBlazor

<PageTitle>Dashboard</PageTitle>

<MudText Typo="Typo.h3" GutterBottom="true">Admin Dashboard</MudText>
<MudText Typo="Typo.body1" Class="mb-6">
    Blank admin shell ready for future functionality.
</MudText>

<MudGrid>
    <MudItem xs="12" sm="6" md="4">
        <MudPaper Class="pa-6">
            <MudText Typo="Typo.h6">Arrangement</MudText>
            <MudText Typo="Typo.body2">Manage tasting sessions and their lifecycle.</MudText>
        </MudPaper>
    </MudItem>
    <MudItem xs="12" sm="6" md="4">
        <MudPaper Class="pa-6">
            <MudText Typo="Typo.h6">Catalog</MudText>
            <MudText Typo="Typo.body2">Prepare breweries and beers before richer workflows arrive.</MudText>
        </MudPaper>
    </MudItem>
    <MudItem xs="12" sm="6" md="4">
        <MudPaper Class="pa-6">
            <MudText Typo="Typo.h6">Insights</MudText>
            <MudText Typo="Typo.body2">Reserve space for ratings and result views later.</MudText>
        </MudPaper>
    </MudItem>
</MudGrid>
