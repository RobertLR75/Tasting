@page "/breweries"
@using MudBlazor
@using Tasting.Admin.Features.Catalog.Models
@using Tasting.Admin.Features.Catalog.Services
@using Tasting.Admin.Shared.Components
@inject IBreweriesApiClient BreweriesApiClient
@inject NavigationManager Navigation

<PageTitle>Breweries</PageTitle>

<PageHeader Title="Breweries" />

<MudStack Row="true" Spacing="2" AlignItems="AlignItems.Center" Class="mb-4">
    <MudTextField @bind-Value="SearchTerm"
                  Label="Search breweries"
                  Placeholder="Search by name"
                  Variant="Variant.Outlined"
                  Immediate="true" />
    <ActionButton Text="Search" Color="Color.Primary" OnClick="@SearchAsync" />
    <ActionButton Text="Add Brewery" Color="Color.Success" OnClick="@(() => Navigation.NavigateTo("/breweries/add"))" />
</MudStack>

@if (ErrorMessage is not null)
{
    <ErrorAlert Message="@ErrorMessage" />
}
else if (IsLoading)
{
    <LoadingIndicator />
}
else if (Breweries.Count == 0)
{
    <MudAlert Severity="Severity.Info" Dense="true">No breweries found.</MudAlert>
}
else
{
    <MudTable Items="Breweries" Hover="true" Dense="true">
        <HeaderContent>
            <MudTh>Name</MudTh>
            <MudTh>Status</MudTh>
            <MudTh>Created</MudTh>
            <MudTh>Actions</MudTh>
        </HeaderContent>
        <RowTemplate>
            <MudTd DataLabel="Name">@context.Name</MudTd>
            <MudTd DataLabel="Status">
                <StatusBadge Status="@(context.IsActive ? "Active" : "Inactive")" />
            </MudTd>
            <MudTd DataLabel="Created">@context.CreatedAt.ToString("yyyy-MM-dd")</MudTd>
            <MudTd DataLabel="Actions">
                <MudStack Row="true" Spacing="1">
                    <MudTooltip Text="Edit brewery">
                        <MudIconButton Icon="@Icons.Material.Filled.Edit" Size="Size.Small" aria-label="Edit brewery" OnClick="@(() => Navigation.NavigateTo($"/breweries/{context.Id}/edit"))" />
                    </MudTooltip>
                    <MudTooltip Text="Manage beers">
                        <MudIconButton Icon="@Icons.Material.Filled.LocalDrink" Size="Size.Small" aria-label="Manage beers" OnClick="@(() => Navigation.NavigateTo($"/breweries/{context.Id}/beers"))" />
                    </MudTooltip>
                </MudStack>
            </MudTd>
        </RowTemplate>
    </MudTable>
}

@code {
    private List<BreweryDto> Breweries { get; set; } = new();
    private string SearchTerm { get; set; } = "";
    private string? ErrorMessage { get; set; }
    private bool IsLoading { get; set; }

    protected override async Task OnInitializedAsync()
    {
        await SearchAsync();
    }

    private async Task SearchAsync()
    {
        IsLoading = true;
        ErrorMessage = null;
        try
        {
            var response = await BreweriesApiClient.ListAsync(SearchTerm);
            Breweries = response?.Breweries.ToList() ?? new();
        }
        catch (Exception ex)
        {
            ErrorMessage = $"Failed to load breweries: {ex.Message}";
        }
        finally
        {
            IsLoading = false;
        }
    }
}

