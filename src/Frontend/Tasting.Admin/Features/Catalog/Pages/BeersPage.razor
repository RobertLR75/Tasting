@page "/breweries/{BreweryId:guid}/beers"
@using MudBlazor
@using Tasting.Admin.Features.Catalog.Models
@using Tasting.Admin.Features.Catalog.Services
@using Tasting.Admin.Shared.Components
@implements IDisposable
@inject IBeersApiClient BeersApiClient
@inject IBreweriesApiClient BreweriesApiClient
@inject NavigationManager Navigation

<PageTitle>Beers</PageTitle>

<PageHeader Title="@(brewery is not null ? $"Beers — {brewery.Name}" : "Beers")" />

<MudStack Row="true" Spacing="2" AlignItems="AlignItems.Center" Class="mb-4">
    <MudTextField @bind-Value="SearchTerm"
                  Label="Search beers"
                  Placeholder="Search by name"
                  Variant="Variant.Outlined"
                  Immediate="true" />
    <ActionButton Text="Search" Color="Color.Primary" OnClick="@SearchAsync" />
    @if (BreweryId != Guid.Empty)
    {
        <ActionButton Text="Add Beer" Color="Color.Success" OnClick="@(() => Navigation.NavigateTo($"/breweries/{BreweryId}/beers/add"))" />
        <ActionButton Text="Back" Color="Color.Default" OnClick="@(() => Navigation.NavigateTo("/breweries"))" />
    }
</MudStack>

@if (ErrorMessage is not null)
{
    <ErrorAlert Message="@ErrorMessage" />
}
else if (IsLoading)
{
    <LoadingIndicator />
}
else if (Beers.Count == 0)
{
    <MudAlert Severity="Severity.Info" Dense="true">No beers found.</MudAlert>
}
else
{
    <MudTable Items="Beers" Hover="true" Dense="true">
        <HeaderContent>
            <MudTh>Name</MudTh>
            <MudTh>Status</MudTh>
            <MudTh>Created</MudTh>
            <MudTh>Actions</MudTh>
        </HeaderContent>
        <RowTemplate>
            <MudTd DataLabel="Name">@context.Name</MudTd>
            <MudTd DataLabel="Status">
                <StatusBadge Status="@(context.IsActive ? "Active" : "Inactive")" />
            </MudTd>
            <MudTd DataLabel="Created">@context.CreatedAt.ToString("yyyy-MM-dd")</MudTd>
            <MudTd DataLabel="Actions">
                <MudStack Row="true" Spacing="1">
                    <MudTooltip Text="Edit beer">
                        <MudIconButton Icon="@Icons.Material.Filled.Edit" Size="Size.Small" aria-label="Edit beer" OnClick="@(() => Navigation.NavigateTo($"/beers/{context.Id}/edit"))" />
                    </MudTooltip>
                </MudStack>
            </MudTd>
        </RowTemplate>
    </MudTable>
}

@code {
    [Parameter]
    public Guid BreweryId { get; set; }

    private BreweryDto? brewery;
    private List<BeerDto> Beers { get; set; } = new();
    private string SearchTerm { get; set; } = "";
    private string? ErrorMessage { get; set; }
    private bool IsLoading { get; set; }
    private readonly CancellationTokenSource _cts = new();

    protected override async Task OnInitializedAsync()
    {
        if (BreweryId != Guid.Empty)
        {
            try
            {
                brewery = await BreweriesApiClient.GetAsync(BreweryId);
            }
            catch (Exception ex)
            {
                ErrorMessage = $"Failed to load brewery: {ex.Message}";
                return;
            }
        }
        await SearchAsync();
    }

    private async Task SearchAsync()
    {
        IsLoading = true;
        ErrorMessage = null;
        try
        {
            var response = await BeersApiClient.ListAsync(
                BreweryId != Guid.Empty ? BreweryId : null,
                SearchTerm);
            Beers = response?.Beers.ToList() ?? new();
        }
        catch (OperationCanceledException)
        {
        }
        catch (Exception ex)
        {
            if (_cts.IsCancellationRequested) return;
            ErrorMessage = $"Failed to load beers: {ex.Message}";
        }
        finally
        {
            if (!_cts.IsCancellationRequested)
                IsLoading = false;
        }
    }

    public void Dispose()
    {
        _cts.Cancel();
        _cts.Dispose();
    }
}

