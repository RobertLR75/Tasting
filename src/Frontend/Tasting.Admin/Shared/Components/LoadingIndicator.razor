@namespace Tasting.Admin.Shared.Components
@using MudBlazor

@if (IsLoading)
{
    <MudProgressLinear Indeterminate="true" Class="mb-4" />
    <MudText Typo="Typo.body2" Align="Align.Center">@LoadingText</MudText>
}

@code {
    [Parameter]
    public bool IsLoading { get; set; } = false;

    [Parameter]
    public string LoadingText { get; set; } = "Loading...";
}
