@namespace Tasting.Admin.Shared.Components

<div class="mb-4">
    <MudText Typo="Typo.h4" GutterBottom="true">@Title</MudText>
    @if (!string.IsNullOrEmpty(Subtitle))
    {
        <MudText Typo="Typo.body2" Color="Color.TextSecondary">@Subtitle</MudText>
    }
    @if (BreadcrumbContent != null)
    {
        <div class="mt-2">
            @BreadcrumbContent
        </div>
    }
</div>

@code {
    [Parameter]
    public string Title { get; set; } = "Page";

    [Parameter]
    public string? Subtitle { get; set; }

    [Parameter]
    public RenderFragment? BreadcrumbContent { get; set; }
}
