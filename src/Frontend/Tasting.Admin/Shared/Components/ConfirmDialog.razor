@namespace Tasting.Admin.Shared.Components
@using MudBlazor

<MudDialog>
    <DialogContent>
        <MudText>@Message</MudText>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="OnCancel" Variant="Variant.Text">Cancel</MudButton>
        <MudButton OnClick="OnConfirm" Color="Color.Primary" Variant="Variant.Filled">@ConfirmText</MudButton>
    </DialogActions>
</MudDialog>

@code {
    [Parameter]
    public string Message { get; set; } = "Are you sure?";

    [Parameter]
    public string ConfirmText { get; set; } = "Confirm";

    [Parameter]
    public EventCallback OnCancelCallback { get; set; }

    [Parameter]
    public EventCallback OnConfirmCallback { get; set; }

    private async Task OnCancel()
    {
        await OnCancelCallback.InvokeAsync();
    }

    private async Task OnConfirm()
    {
        await OnConfirmCallback.InvokeAsync();
    }
}
