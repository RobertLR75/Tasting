@namespace Tasting.Admin.Shared.Components

@if (!string.IsNullOrEmpty(Message))
{
    <MudAlert Severity="Severity.Error" ShowCloseIcon="true" CloseIconClicked="HandleClose" Class="mb-4">
        @Message
    </MudAlert>
}

@code {
    [Parameter]
    public string? Message { get; set; }

    [Parameter]
    public EventCallback OnClose { get; set; }

    private async Task HandleClose()
    {
        await OnClose.InvokeAsync();
    }
}
